# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/procurement_db?schema=public"

# For Docker deployment:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/procurement_db?schema=public"

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_BASE_URL=http://localhost:3000  # For local development
# OR in Docker:
NEXT_PUBLIC_BASE_URL=http://host.docker.internal:3000

# AI Configuration - REQUIRED
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Storage Configuration
NEXT_PUBLIC_USE_FILE_STORAGE=false

# Session Configuration
SESSION_SECRET=default-secret-change-in-production


